#FIFO = first in first out (dat struktura QUEUE)

#LIFO = last in first out  (dat struktura STACK)
#FIFO = first in first out (dat struktura QUEUE)

class Stack:
    def __init__(self):
        self.zoz = []

    def is_empty(self):
        if len(self.zoz) == 0:
            return True
        else:
            return False

    def push(self,item):
        self.zoz.append(item)

    def pop(self):
        if not self.is_empty():
            return self.zoz.pop(-1)
        else:
            return False

    def peek(self):
        if not self.is_empty():
            return self.zoz[-1]
        else:
            return False

    def size(self):
        return len(self.zoz)


hodnoty = {"+":1,"-":1,"*":2,"/":2,"(":0,")":0}

op_stack = Stack()
output = list()


expression = input("Zadaj ciselny vyraz:")
for char in expression:
    if char.isdigit():
        output.append(char)
    elif char == "(":
        op_stack.push(char)
    elif char == (")"):
        while op_stack.peek() != "(":
            output.append(op_stack.pop())
        op_stack.pop()
    elif char in "+-/*":
            while (not op_stack.is_empty()) and hodnoty[char] <= hodnoty[op_stack.peek()]:
                output.append(op_stack.pop())
            op_stack.push(char)

while op_stack.size() != 0:
    output.append(op_stack.pop())



print(output)
operand_stack = Stack()
for char in output:
    if char.isdigit():
        operand_stack.push(int(char))
    else:
        second = operand_stack.pop()
        first = operand_stack.pop()
        if char == "+":
            operand_stack.push(first+second)
        elif char == "-":
            operand_stack.push(first-second)
        elif char == "*":
            operand_stack.push(first*second)
        elif char == "/":
            operand_stack.push(first / second)
print(operand_stack.zoz)
